# AFTERFALL has no runtime secrets: the game reads no environment variables.
# These optional variables tune the local tooling scripts in tools/. Copy the lines you need
# into your shell profile, or run: set -a; . ./.env; set +a   (.env is git-ignored).

# Path to the Unity 6000.3.28f1 editor binary (tools/run-unity-checks.sh, tools/gallery.sh).
UNITY=/Applications/Unity/Hub/Editor/6000.3.28f1/Unity.app/Contents/MacOS/Unity

# Number of gallery captures tools/gallery.sh runs in parallel.
AFTERFALL_UNITY_SLOTS=3

# Set to 1 to make tools/gallery.sh reuse an existing Builds/macOS/AFTERFALL.app.
AFTERFALL_GALLERY_NO_BUILD=0
