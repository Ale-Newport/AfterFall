/* AFTERFALL UI — muted post-apocalyptic palette, high-contrast text. */
.root {
    position: absolute; left: 0; top: 0; right: 0; bottom: 0;
    -unity-font-style: normal;
    color: rgb(226, 222, 210);
    font-size: 16px;
}
.layer { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.hidden { display: none; }

.panel {
    background-color: rgba(18, 20, 18, 0.93);
    border-color: rgba(150, 140, 110, 0.55);
    border-width: 1px;
    border-radius: 6px;
    padding: 10px;
}
.window {
    position: absolute;
    background-color: rgba(20, 22, 20, 0.99);
    border-color: rgba(170, 155, 110, 0.6);
    border-width: 1px;
    border-radius: 8px;
    padding: 12px;
}
.window-center { left: 8%; right: 8%; top: 8%; bottom: 10%; }
.title { font-size: 24px; -unity-font-style: bold; color: rgb(238, 205, 120); margin-bottom: 6px; }
.subtitle { font-size: 18px; -unity-font-style: bold; color: rgb(210, 196, 150); margin-top: 6px; margin-bottom: 4px; }
.muted { color: rgb(160, 156, 145); font-size: 14px; white-space: normal; }
.warn { color: rgb(240, 170, 80); white-space: normal; }
.bad { color: rgb(235, 95, 80); white-space: normal; }
.good { color: rgb(130, 210, 120); white-space: normal; }
.wrap { white-space: normal; }
.row { flex-direction: row; align-items: center; }
.col { flex-direction: column; }
.grow { flex-grow: 1; }
.spacer { flex-grow: 1; }

.btn {
    background-color: rgb(58, 60, 52);
    border-color: rgb(120, 112, 86);
    border-width: 1px;
    border-radius: 4px;
    color: rgb(232, 226, 210);
    padding: 6px 12px;
    margin: 3px;
    font-size: 16px;
    -unity-text-align: middle-center;
}
.btn:hover { background-color: rgb(82, 84, 70); border-color: rgb(220, 190, 110); }
.btn:active { background-color: rgb(110, 98, 60); }
.btn--primary { background-color: rgb(120, 88, 36); border-color: rgb(230, 190, 100); }
.btn--primary:hover { background-color: rgb(150, 112, 46); }
.btn--danger { background-color: rgb(110, 40, 34); }
.btn--small { padding: 2px 8px; font-size: 14px; }
.btn--list { white-space: normal; -unity-text-align: middle-left; }

/* Text inputs: the default theme draws a white field, which hides our light text. */
.unity-base-text-field__input, .unity-text-field__input {
    background-color: rgb(30, 32, 28);
    color: rgb(236, 230, 214);
    border-color: rgb(120, 112, 86);
    --unity-cursor-color: rgb(240, 214, 140);
    --unity-selection-color: rgba(200, 160, 70, 0.45);
}
.unity-base-field__label { color: rgb(220, 214, 196); }
.btn--disabled { opacity: 0.45; }
.btn--selected { border-color: rgb(250, 210, 110); background-color: rgb(92, 80, 48); }
.menu-btn { width: 340px; height: 52px; font-size: 22px; }

/* Item slots: a recessed well (dark top-left edge, lit bottom-right edge) under a shading overlay
   texture set from code (ItemIcons.SlotShade); the item icon sits on top without any colour square. */
.slot {
    width: 64px; height: 64px;
    margin: 3px;
    background-color: rgba(42, 43, 38, 0.96);
    -unity-background-scale-mode: stretch-to-fill;
    border-width: 1px;
    border-top-color: rgba(6, 6, 5, 0.95);
    border-left-color: rgba(6, 6, 5, 0.95);
    border-bottom-color: rgba(132, 122, 96, 0.55);
    border-right-color: rgba(132, 122, 96, 0.55);
    border-radius: 6px;
}
.slot--hotbar { background-color: rgba(50, 48, 40, 0.96); }
.slot--filled { background-color: rgba(54, 55, 48, 0.97); }
.slot:hover { border-color: rgb(236, 200, 118); background-color: rgba(66, 64, 52, 0.97); }
.slot--selected { border-color: rgb(255, 215, 110); border-width: 2px; background-color: rgba(98, 80, 42, 0.97); }
.slot--active { border-color: rgb(255, 222, 120); border-width: 3px; background-color: rgba(84, 72, 42, 0.97); }
.slot--locked { opacity: 0.5; }
.slot-icon {
    position: absolute; left: 3px; top: 3px; right: 3px; bottom: 3px;
    -unity-background-scale-mode: scale-to-fit;
}
.slot-qty {
    position: absolute; right: 4px; bottom: 1px;
    font-size: 15px; -unity-font-style: bold; color: rgb(255, 252, 240);
    -unity-text-outline-width: 1px; -unity-text-outline-color: rgba(0, 0, 0, 0.85);
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.95);
}
.slot-key {
    position: absolute; left: 5px; top: 2px;
    font-size: 12px; -unity-font-style: bold; color: rgb(232, 220, 182);
    text-shadow: 1px 1px 1px rgba(0, 0, 0, 0.95);
}
.slot-dur-track { position: absolute; left: 7px; right: 7px; bottom: 4px; height: 4px; background-color: rgba(0, 0, 0, 0.7); border-radius: 2px; }
.slot-dur { position: absolute; left: 0; top: 0; bottom: 0; border-radius: 2px; background-color: rgb(110, 200, 90); }
.grid { flex-direction: row; flex-wrap: wrap; }

/* Item icons outside slots (recipes, costs, fuel, HUD) */
.item-icon { flex-shrink: 0; -unity-background-scale-mode: scale-to-fit; }
.icon-16 { width: 16px; height: 16px; }
.icon-20 { width: 20px; height: 20px; }
.icon-24 { width: 24px; height: 24px; }
.icon-28 { width: 28px; height: 28px; }
.icon-32 { width: 32px; height: 32px; }
.icon-36 { width: 36px; height: 36px; }
.icon-48 { width: 48px; height: 48px; }
.icon-64 { width: 64px; height: 64px; }
.chip { flex-direction: row; align-items: center; margin-right: 10px; margin-top: 1px; margin-bottom: 1px; }
.chip-label { font-size: 15px; margin-left: 3px; }
.formula { flex-direction: row; flex-wrap: wrap; align-items: center; }
.formula-op { font-size: 14px; color: rgb(170, 164, 148); margin-right: 8px; margin-left: -4px; }
.formula > .item-icon { margin-right: 10px; }
.cost-row { margin-top: 2px; }
.cost-label { margin-right: 8px; }
.fuel-head { margin-top: 6px; }
.fuel-head > .subtitle { margin-right: 12px; }

/* Recipe rows: output icon, name, status tag */
.recipe-row { flex-direction: row; align-items: center; padding: 2px 8px 2px 4px; min-height: 38px; }
.recipe-name { flex-grow: 1; margin-left: 8px; font-size: 15px; -unity-text-align: middle-left; }
.recipe-title { font-size: 15px; -unity-font-style: bold; -unity-text-align: middle-left; }
.recipe-tag { font-size: 12px; color: rgb(170, 164, 148); -unity-text-align: middle-right; margin-left: 6px; }
.recipe-tag.good { color: rgb(130, 210, 120); }
.recipe-tag.warn { color: rgb(240, 170, 80); }
.recipe-tag.bad { color: rgb(235, 95, 80); }
.recipe-panel {
    margin-top: 6px; padding: 8px;
    background-color: rgba(0, 0, 0, 0.28);
    border-width: 1px; border-color: rgba(120, 110, 84, 0.45); border-radius: 6px;
}
.recipe-panel > .formula { margin-top: 6px; margin-bottom: 4px; }
.item-detail { margin-top: 6px; }
.item-detail > .item-icon { margin-right: 10px; margin-top: 6px; }
.queue-row { margin-bottom: 2px; }
.queue-name { margin-left: 6px; }

/* Bars */
.bar { height: 20px; background-color: rgba(0, 0, 0, 0.55); border-radius: 3px; margin: 2px 0; overflow: hidden; }
.bar-fill { position: absolute; left: 0; top: 0; bottom: 0; border-radius: 3px; }
.bar-label { position: absolute; left: 6px; right: 6px; top: 0; bottom: 0; font-size: 13px; -unity-font-style: bold; -unity-text-align: middle-left; color: rgb(250, 248, 240); text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.9); }

/* HUD */
.hud-vitals { position: absolute; left: 18px; bottom: 18px; width: 300px; }
.hud-clock { position: absolute; right: 18px; top: 14px; font-size: 20px; -unity-font-style: bold; color: rgb(240, 225, 180); text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.9); }
.hud-hotbar { position: absolute; bottom: 14px; left: 0; right: 0; flex-direction: row; justify-content: center; }
.hud-prompt {
    position: absolute; left: 30%; right: 30%; top: 58%;
    -unity-text-align: middle-center; font-size: 18px; white-space: normal;
    background-color: rgba(0, 0, 0, 0.55); border-radius: 6px; padding: 6px;
}
.hud-caption {
    position: absolute; left: 25%; right: 25%; bottom: 96px;
    -unity-text-align: middle-center; font-size: 17px; white-space: normal;
    background-color: rgba(0, 0, 0, 0.7); color: rgb(255, 250, 230); border-radius: 4px; padding: 4px 8px;
}
.hud-crosshair { position: absolute; left: 50%; top: 50%; width: 6px; height: 6px; margin-left: -3px; margin-top: -3px; border-radius: 3px; background-color: rgba(255, 255, 255, 0.8); }
.hud-mode { position: absolute; left: 25%; right: 25%; top: 10px; -unity-text-align: upper-center; font-size: 17px; background-color: rgba(0, 0, 0, 0.5); border-radius: 6px; padding: 4px 10px; color: rgb(240, 210, 130); text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.9); }
.hud-equipped { font-size: 14px; color: rgb(220, 214, 196); margin-top: 4px; }
.hud-hand { margin-top: 2px; }
.hud-hand > .hud-equipped { margin-top: 0; margin-left: 6px; }
.hud-craft { position: absolute; right: 18px; bottom: 100px; width: 280px; }
.hud-placement { position: absolute; left: 50%; bottom: 100px; width: 520px; margin-left: -260px; }
.hud-warning { position: absolute; left: 18px; top: 14px; width: 420px; }

.toasts { position: absolute; right: 18px; top: 52px; width: 440px; align-items: flex-end; }
.toasts--beside-panel { right: 410px; }
.toast {
    background-color: rgba(20, 22, 20, 0.92); border-radius: 5px; padding: 6px 10px; margin-bottom: 4px;
    border-left-width: 4px; border-left-color: rgb(160, 160, 150); white-space: normal; font-size: 15px;
}
.toast--Success { border-left-color: rgb(110, 200, 100); }
.toast--Warning { border-left-color: rgb(240, 170, 60); }
.toast--Danger { border-left-color: rgb(235, 80, 70); background-color: rgba(60, 16, 14, 0.94); }

/* Main menu */
.menu-bg { background-color: rgb(14, 15, 13); align-items: center; justify-content: center; }
.logo { font-size: 72px; -unity-font-style: bold; color: rgb(232, 196, 110); letter-spacing: 12px; }
.tagline { font-size: 20px; color: rgb(170, 162, 140); margin-bottom: 30px; }

.list-item { flex-direction: row; align-items: center; padding: 4px 6px; border-bottom-width: 1px; border-bottom-color: rgba(90, 86, 72, 0.45); }
.list-item:hover { background-color: rgba(80, 72, 50, 0.35); }
.list-item--selected { background-color: rgba(110, 90, 46, 0.55); }

.tactical-left { position: absolute; left: 14px; top: 50px; width: 330px; }
.tactical-right { position: absolute; right: 14px; top: 50px; width: 380px; }
.overlay-label {
    position: absolute; font-size: 13px; padding: 1px 5px; border-radius: 3px;
    background-color: rgba(0, 0, 0, 0.6); color: rgb(240, 236, 220);
}
.overlay-label--bad { background-color: rgba(120, 30, 24, 0.85); }
.overlay-label--good { background-color: rgba(40, 90, 40, 0.8); }
.overlay-label--threat { background-color: rgba(150, 20, 20, 0.9); -unity-font-style: bold; }

.death { background-color: rgba(30, 0, 0, 0.7); align-items: center; justify-content: center; }
.death-title { font-size: 64px; -unity-font-style: bold; color: rgb(220, 70, 60); }
.loading { background-color: rgb(12, 13, 12); align-items: center; justify-content: center; }

.tooltip {
    position: absolute; max-width: 360px; white-space: normal; font-size: 14px;
    background-color: rgba(10, 11, 10, 0.95); border-color: rgb(170, 155, 110); border-width: 1px;
    border-radius: 4px; padding: 6px 8px; color: rgb(236, 230, 214);
}
