<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Runs the Unity EditMode test sources (Assets/Tests/EditMode) under plain .NET + NUnit 3,
    so domain logic can be verified without the Unity Editor. The same files run inside
    Unity's Test Runner (Unity Test Framework uses NUnit 3.5).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>$(NoWarn);CS1591;NUnit2005;NUnit2006;NUnit2007;NUnit2015;NUnit2003;NUnit2004</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../../Assets/Tests/EditMode/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../../../Assets/_Afterfall/Resources/Content/*.json" LinkBase="Content" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../AfterfallSim/AfterfallSim.csproj" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.2" />
  </ItemGroup>
</Project>
