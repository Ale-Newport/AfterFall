<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Renders AFTERFALL's procedural art (surface textures and item icons) to PNG without Unity,
    from the engine-independent sources in Assets/_Afterfall/Scripts/Presentation/Art.
    Usage is described at the top of Program.cs.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../../Assets/_Afterfall/Scripts/Presentation/Art/**/*.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>
</Project>
